#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Stay in the service directory: s6-notifyoncheck finds its supervisor via ./supervise.
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    exec \
        s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost ${PORT:-8484}" \
            s6-setuidgid abc node /app/media-ops/server.js
else
    exec \
        s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost ${PORT:-8484}" \
            node /app/media-ops/server.js
fi

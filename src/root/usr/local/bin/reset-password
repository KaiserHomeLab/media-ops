# Removes the Media Ops settings password. Run from the container console: reset-password
# Runs as abc so /config/config.json keeps the right owner.
if [[ $(id -u) -eq 0 ]] && [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    exec s6-setuidgid abc node /app/media-ops/bin/reset-password.js "$@"
fi
exec node /app/media-ops/bin/reset-password.js "$@"
